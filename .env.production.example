# Copy to .env.production and replace all values.

# Network / browser origin
CORS_ALLOWED_ORIGINS=https://ducklake.your-tailnet.ts.net

# Runner <-> API trust (comma-separated for rotation)
RUNNER_AUTH_TOKENS=replace-with-long-random-token-1,replace-with-long-random-token-2

# API auth: choose one model
# Option A: API key auth (comma-separated)
API_KEYS=replace-with-long-random-api-key
# Option B: JWT auth (HS256)
JWT_HS256_SECRET=

# Capacity
RUNNER_MAX_CONCURRENT_QUERIES=8
MAX_CONCURRENT_JOBS=16
